# =============================================================================
# BaaS — variáveis de ambiente
# Copie para .env: cp .env.example .env
# Gere GATEWAY_ENCRYPTION_KEY: openssl rand -base64 32
# =============================================================================

# --- MySQL (docker-compose) ---
MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=baas
DB_USER=baas
DB_PASSWORD=change_me_db

# --- Auth BaaS ---
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# --- Gateway Lera Box (BranchPay) ---
# Sandbox: https://api.branchpay.com.br/api
GATEWAY_BASE_URL=https://api.branchpay.com.br/api

# Chave AES-256-GCM (32 bytes em base64) — criptografa Bearer Lera no banco
GATEWAY_ENCRYPTION_KEY=

# Secret compartilhado com Lera ao registrar webhooks (header X-Lera-Box-Signature)
WEBHOOK_HMAC_SECRET=change_me_webhook_secret

# --- URLs da aplicação ---
# Local Docker:
FRONTEND_URL=http://localhost:8080
VITE_API_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000

# Produção (exemplo):
# FRONTEND_URL=https://baas.example.com
# VITE_API_URL=https://api.example.com
# API_PUBLIC_URL=https://api.example.com

# --- E-mail (opcional — envio de link de checkout via Resend) ---
RESEND_API_KEY=
EMAIL_FROM="BaaS <noreply@example.com>"
